# Copie para .env e preencha. O .env está no .gitignore e nunca vai para o repositório.
# Em produção (Streamlit Community Cloud), as mesmas chaves vão em Settings > Secrets.

# Obrigatória: chave da API do Gemini (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Opcional: modelo do Gemini. Padrão: gemini-3.8-flash.
GEMINI_MODEL=

# Opcional: modelos de reserva, separados por vírgula, usados se o principal estiver sem cota (429) ou com alta demanda (503).
# Padrão: gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=

# Opcionais: identificação do projeto Google Cloud. A chave do AI Studio não precisa delas;
# só são usadas se GOOGLE_GENAI_USE_VERTEXAI=true (modo Vertex AI, autenticação pelo gcloud).
GOOGLE_CLOUD_PROJECT_NAME=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
